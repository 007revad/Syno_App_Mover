#!/bin/bash

PKG_NAME="App_Mover"
TARGET_DIR="/var/packages/${PKG_NAME}/target"
BIN_DIR="${TARGET_DIR}/bin"

# Get DSM major version
dsm=$(/usr/syno/bin/synogetkeyvalue /etc.defaults/VERSION majorversion)
if [[ $dsm -ge 7 ]]; then
    VAR_DIR="/var/packages/${PKG_NAME}/var"
else
    VAR_DIR="/var/packages/${PKG_NAME}/etc"
fi

log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "${VAR_DIR}/install.log" 2>/dev/null || true
}

# DSM runs preuninst when it upgrades the package as well (with
# SYNOPKG_PKG_STATUS=UPGRADE). The scheduled backup has to survive that, or
# every upgrade would silently delete the user's schedule. The task runs
# app_mover_api.sh by its full path, which is the same after an upgrade.
if [[ "$SYNOPKG_PKG_STATUS" == "UPGRADE" ]]; then
    log_message "preuninst: upgrading - scheduled task left in place"
    exit 0
fi

# Remove the scheduled task so uninstalling doesn't leave an orphaned
# task pointing at a script that no longer exists (which would fail
# silently, or email the user, on its next scheduled run).
#
# DSM 7: preuninst runs as the package user, so this has to go
# through the setuid helper, same as everything else in this package.
# DSM 6: preuninst runs as root already, so task_setup.sh can be
# called directly.
#
# Either way, a failure here must never block the uninstall itself -
# an orphaned task is a much smaller problem than a package the user
# can no longer remove.
if [[ $dsm -ge 7 ]]; then
    HELPER="${BIN_DIR}/helper/appmover-helper"
    if [[ -u "$HELPER" ]]; then
        "$HELPER" removeschedule >/dev/null 2>>"${VAR_DIR}/api.log"
        log_message "preuninst: removed scheduled task via helper"
    else
        log_message "preuninst: helper missing or not setuid - scheduled task not removed"
    fi
else
    TASK_SETUP="${BIN_DIR}/task_setup.sh"
    # Same task name as TASK_NAME in app_mover_api.sh (task_setup.sh is the
    # generic one and needs to be told which task)
    TASK_NAME="App Mover Backup"
    if [[ -x "$TASK_SETUP" ]]; then
        "$TASK_SETUP" remove --name="$TASK_NAME" >/dev/null 2>>"${VAR_DIR}/api.log"
        log_message "preuninst: removed scheduled task directly (DSM6)"
    else
        log_message "preuninst: task_setup.sh missing - scheduled task not removed"
    fi
fi

exit 0
