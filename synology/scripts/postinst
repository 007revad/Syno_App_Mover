#!/bin/bash

PKG_NAME=$(basename "$SYNOPKG_PKGDEST")
TARGET_DIR="/var/packages/$PKG_NAME/target"
UI_DIR="$TARGET_DIR/ui"
BIN_DIR="$TARGET_DIR/bin"
SBIN_DIR="$TARGET_DIR/sbin"

# Get DSM major version
dsm=$(/usr/syno/bin/synogetkeyvalue /etc.defaults/VERSION majorversion)
if [[ $dsm -ge 7 ]]; then
    VAR_DIR="/var/packages/${PKG_NAME}/var"
else
    VAR_DIR="/var/packages/${PKG_NAME}/etc"
fi

# Log function
log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$VAR_DIR/install.log" 2>/dev/null || echo "$1"
}

echo "" >> "$VAR_DIR/install.log"

log_message "Post-installation starting for package: $PKG_NAME"
log_message "Running as $(id -un) (uid=$(id -u), gid=$(id -g))"

echo "" >> "$VAR_DIR/api.log"

# Remove spurious files injected by the package builder
rm -f "$UI_DIR/Makefile"
rm -f "$UI_DIR/ui"  # self-referencing symlink
rm -f "$UI_DIR/texts/strings"  # strings file template
log_message "Removed spurious package builder files"

if [[ $dsm -le 6 ]]; then
    rm -f "$TARGET_DIR/bin/helper/appmover-helper"
    log_message "Removed helper/appmover-helper (only needed for DSM 7)"   
fi

# Set execute permissions
chmod +x "$UI_DIR/api.cgi" 2>/dev/null
log_message "Set execute permissions for api.cgi"
chmod +x "$BIN_DIR/app_mover_api.sh" 2>/dev/null
log_message "Set execute permissions for app_mover_api.sh"
chmod +x "$BIN_DIR/syno_app_mover.sh" 2>/dev/null
log_message "Set execute permissions for syno_app_mover.sh"
chmod +x "$BIN_DIR/task_setup.sh" 2>/dev/null
log_message "Set execute permissions for task_setup.sh"
chmod +x "$BIN_DIR/check_share_volume.sh" 2>/dev/null
log_message "Set execute permissions for check_share_volume.sh"


# Lock down app_mover_api.sh
chmod 555 "$BIN_DIR/app_mover_api.sh" 2>/dev/null    # Blocks injection exploit
log_message "Secured app_mover_api.sh"

# Lock down bin, sbin and helper folders
# Must be after "chmod 555" and "chmod +x" for files in these folders
chmod 555 "$BIN_DIR" 2>/dev/null                     # Blocks delete/recreate exploit
chmod 555 "$SBIN_DIR" 2>/dev/null                    # Blocks delete/recreate exploit
chmod 555 "$TARGET_DIR/bin/helper" 2>/dev/null       # Blocks delete/recreate/rename exploit
log_message "Secured bin, sbin and helper folders"

# Lock down target folder
# Must be the last command (apart from logging and appmover-helper)
chmod 555 "/var/packages/${PKG_NAME}/target" 2>/dev/null   # Blocks delete/recreate/rename exploit

if [[ $dsm -ge 7 ]]; then
    HELPER="$TARGET_DIR/bin/helper/appmover-helper"
    if [[ -u "$HELPER" ]]; then
        result="$("$HELPER" selfheal 2>&1)"
        rc=$?
        log_message "Triggered self-heal via helper"
        log_message "App_Mover postinst: selfheal exit=${rc} output: ${result}"
    else
        log_message "Helper not yet setuid-root - self-heal deferred to first UI open"
    fi
fi


if [ -z "$ERRORS" ]; then
    log_message "Post-installation completed successfully"
else
    log_message "Post-installation completed with warnings"
fi
echo >> "$VAR_DIR/install.log"
exit 0
